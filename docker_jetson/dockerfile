# Jetson AGX Thor Developer Kit — JetPack 7.2 GA / Jetson Linux (L4T) 39.2.0
#
# JetPack 7.2 = Ubuntu 24.04 (noble) + kernel 6.8 + CUDA 13.2.1 + cuDNN 9.20 + TensorRT 10.16.2.
# Thor is an SBSA arm64 platform, so there is no `l4t-jetpack` / `l4t-base` image for it:
# NVIDIA's guidance is to use the regular NGC CUDA arm64 images as the base.
#
# CUDA 13.0.2 is used rather than 13.2.1 so that the toolkit matches the `cu130` SBSA
# PyTorch wheels the extensions below are compiled against. The JetPack 7.2 driver
# (CUDA 13.2.1) is backward compatible with it. Override with --build-arg if needed.
ARG BASE_IMAGE=nvcr.io/nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04
FROM ${BASE_IMAGE}

# Thor's integrated Blackwell GPU is sm_110 (it was sm_101 before CUDA 13.0).
ENV TORCH_CUDA_ARCH_LIST=11.0
ENV CUDA_HOME=/usr/local/cuda
ARG MAX_JOBS=8
ENV MAX_JOBS=${MAX_JOBS}
# Ubuntu 24.04 marks its Python as externally managed (PEP 668); we install into it on purpose
# so that pip packages and the ROS2 apt packages share the same Python 3.12.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

ENV TZ=US/Pacific
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ARG DEBIAN_FRONTEND=noninteractive

# libtiff5-dev is a transitional package on noble, libtiff-dev is the real one.
RUN apt-get update --fix-missing && \
    apt-get install -y libgtk2.0-dev && \
    apt-get install -y wget bzip2 ca-certificates curl git vim tmux g++ gcc build-essential cmake checkinstall gfortran libjpeg8-dev libtiff-dev pkg-config yasm libavcodec-dev && \
    apt-get install -y wget libavformat-dev libswscale-dev libdc1394-dev libxine2-dev libv4l-dev qtbase5-dev qt5-qmake libgtk2.0-dev libtbb-dev libatlas-base-dev libfaac-dev && \
    apt-get install -y wget libmp3lame-dev libtheora-dev libvorbis-dev libxvidcore-dev libopencore-amrnb-dev libopencore-amrwb-dev x264 v4l-utils libprotobuf-dev protobuf-compiler && \
    apt-get install -y wget libgoogle-glog-dev libgflags-dev libgphoto2-dev libhdf5-dev doxygen libflann-dev libboost-all-dev proj-data libproj-dev libyaml-cpp-dev cmake-curses-gui && \
    apt-get install -y wget libzmq3-dev freeglut3-dev libegl1 libgl1-mesa-dev libosmesa6-dev


RUN cd / && git clone https://github.com/pybind/pybind11 &&\
    cd pybind11 && git checkout v2.10.0 &&\
    mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release -DPYBIND11_INSTALL=ON -DPYBIND11_TEST=OFF &&\
    make -j6 && make install


RUN cd / && wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz &&\
    tar xvzf ./eigen-3.4.0.tar.gz &&\
    cd eigen-3.4.0 &&\
    mkdir build &&\
    cd build &&\
    cmake .. &&\
    make install

SHELL ["/bin/bash", "--login", "-c"]

###### Install Python Dependencies (Python 3.12 on Ubuntu 24.04)
RUN apt-get install -y \
    python-is-python3 \
    python3-pip \
    python3-dev

RUN pip install "setuptools<81"

###### PyTorch for Thor
# There is no aarch64 CUDA build of torch on PyPI. The Jetson AI Lab index publishes SBSA
# wheels compiled for CUDA 13.0 with sm_110 kernels, which is what Thor needs.
# torch 2.11.0 is on the index too, but the newest torchvision published there is 0.25.0,
# which pins torch==2.10.0, so 2.10.0 is the highest self-consistent set.
ARG TORCH_INDEX_URL=https://pypi.jetson-ai-lab.io/sbsa/cu130
RUN pip install torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
    --index-url ${TORCH_INDEX_URL} --extra-index-url https://pypi.org/simple

# Those wheels link against libcudss.so.0, which is not part of the CUDA toolkit, and cuDSS
# installs outside the default loader path.
RUN apt-get update && apt-get install -y libcudss0-cuda-13
ENV LD_LIBRARY_PATH=/usr/local/cuda/targets/sbsa-linux/lib:/usr/lib/aarch64-linux-gnu/libcudss/13:${LD_LIBRARY_PATH}

RUN python3 -c "import torch; print('torch', torch.__version__, 'cuda build', torch.version.cuda)"

RUN pip install "git+https://github.com/facebookresearch/pytorch3d.git@stable" --no-build-isolation

# The torch line above keeps --extra-index-url so Docker can reuse the cached layers through
# pytorch3d. PyPI's manylinux_2_28_aarch64 torch ranks above the Jetson linux_aarch64 CUDA
# wheel and can leave a CPU-only install; force the CUDA wheels from the Jetson index only.
# --no-deps skips nvpl (Grace/SBSA BLAS+LAPACK), which those wheels need at import time.
RUN pip install --force-reinstall --no-deps \
    torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
    --index-url ${TORCH_INDEX_URL}
RUN pip install nvpl
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvpl/lib:${LD_LIBRARY_PATH}
RUN python3 -c "import torch; from torch.utils.cpp_extension import CUDA_HOME; \
    print('torch', torch.__version__, '| cuda build', torch.version.cuda, '| CUDA_HOME', CUDA_HOME); \
    assert torch.version.cuda and CUDA_HOME, 'CPU-only torch installed, check the wheel index'"

# opencv-python has no aarch64 wheel for its 5.x line; 4.13.0.90 ships an abi3 aarch64 wheel
# that works on Python 3.12 and avoids an hour-long source build.
RUN pip install scipy joblib scikit-learn ruamel.yaml trimesh pyyaml "opencv-python==4.13.0.90" imageio transformations einops kornia pyrender "cython>=0.29.37"

# open3d publishes aarch64 wheels on GitHub only (the PyPI wheels are x86_64 / macOS).
RUN pip install https://github.com/isl-org/Open3D/releases/download/main-devel/open3d-0.19.0-cp312-cp312-manylinux_2_35_aarch64.whl

# Same story for warp-lang: the aarch64 CUDA 13 build lives in the GitHub release assets.
RUN pip install https://github.com/NVIDIA/warp/releases/download/v1.16.0/warp_lang-1.16.0+cu13-py3-none-manylinux_2_34_aarch64.whl

# RUN cd / && git clone --recursive https://github.com/NVIDIAGameWorks/kaolin
# RUN cd /kaolin && TORCH_CUDA_ARCH_LIST="11.0" FORCE_CUDA=1 pip install -e . --no-build-isolation

# RUN python3 -m pip install --upgrade pip
RUN pip install --upgrade setuptools
RUN cd / && git clone https://github.com/NVlabs/nvdiffrast && cd /nvdiffrast && \
    TORCH_CUDA_ARCH_LIST="11.0" python3 -m pip install . --no-build-isolation --no-cache-dir
RUN python3 -c "import nvdiffrast.torch as dr; print('nvdiffrast OK')"

ENV OPENCV_IO_ENABLE_OPENEXR=1

RUN pip install scikit-image meshcat webdataset omegaconf pypng roma seaborn "opencv-contrib-python==4.13.0.90"

RUN pip install openpyxl wandb imgaug Ninja xlsxwriter timm albumentations xatlas rtree nodejs jupyterlab objaverse g4f ultralytics==8.0.120 pycocotools videoio numba

RUN pip install h5py



# JetPack 7.2 is Ubuntu 24.04 based, so the matching ROS2 LTS distro is Jazzy (not Humble).
ENV ROS_DISTRO=jazzy

RUN apt-get update && apt-get upgrade -yy

###### Install ROS2
RUN apt-get install -y \
    curl \
    gnupg2 \
    lsb-release

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt-get update && apt-get upgrade -y
RUN apt install ros-${ROS_DISTRO}-desktop-full -y
RUN apt install ros-dev-tools -y
RUN pip install "setuptools<81"
RUN rosdep init && rosdep update

###### Install ROS Dependencies
RUN apt install -y \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-rviz2

###### Install Intel RealSense (librealsense2 + ROS2 wrapper)
# Note: kernel-level drivers run on the host; the container needs the userspace SDK
# and ROS2 packages. USB access is handled at `docker run` time (see run script).
RUN apt-get update && apt-get install -y \
    udev \
    usbutils \
    ros-${ROS_DISTRO}-librealsense2* \
    ros-${ROS_DISTRO}-realsense2-* \
 && rm -rf /var/lib/apt/lists/*

###### Set up ROS2 environment (Python 3.12 on noble)
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "export LD_LIBRARY_PATH=/opt/ros/${ROS_DISTRO}/lib:\$LD_LIBRARY_PATH" >> ~/.bashrc && \
    echo "export AMENT_PREFIX_PATH=/opt/ros/${ROS_DISTRO}:\$AMENT_PREFIX_PATH" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=0" >> ~/.bashrc && \
    echo "export PYTHONPATH=/opt/ros/${ROS_DISTRO}/lib/python3.12/site-packages:\$PYTHONPATH" >> ~/.bashrc

###### Update Buffer
# /proc/sys is read-only during the build; these are applied on the host by run_container.sh.
RUN sysctl net.ipv4.ipfrag_time=3 || true
RUN sysctl net.ipv4.ipfrag_high_thresh=134217728 || true

RUN echo "export FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA?max_msg_size=1MB&soets_size=1MB&non_blocking=true&tcp_negotiation_timeout=50" >> ~/.bashrc

###### Source ROS2 and workspace (ros2_ws only if present, e.g. mounted)
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc
RUN echo "[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash" >> ~/.bashrc

RUN apt-get update && apt-get install -y ros-${ROS_DISTRO}-rmw-cyclonedds-cpp
RUN echo "export ROS_DOMAIN_ID=2" >> ~/.bashrc

## Fix some versions
RUN pip install ultralytics==8.4


# Setup shell
ENV SHELL=/bin/bash
RUN ln -sf /bin/bash /bin/sh

###### TensorRT + ONNX Runtime for FoundationPose ONNX on Jetson / Thor
# Appended last to preserve the build cache of the large layers above.
#
# Upstream PyPI has no aarch64 onnxruntime-gpu wheel. Building ORT from source with
# TensorRT on Thor/JP7.2 is very slow and currently fails near the end of the link
# step, so we install TensorRT system libs + a prebuilt JetPack 7.2 aarch64 wheel
# (Ultralytics / Jetson Zoo path for Python 3.12).
#
# The version must be pinned: the sbsa CUDA repo now also carries TensorRT 11, which an
# unpinned `apt install tensorrt` picks up. TensorRT 11 only provides libnvinfer.so.11,
# while the ONNX Runtime wheel's TensorRT EP is linked against libnvinfer.so.10, so the
# EP fails to dlopen and ORT silently falls back to CPU. 10.16.1 is the closest 10.x in
# this repo to the TensorRT 10.16.2 that JetPack 7.2 ships on the host.
#
# Pinning only the `tensorrt` metapackage is not enough: apt picks the candidate (newest,
# 11.x) version of each unversioned dependency it shares with the TensorRT 11 line and
# fails with unmet deps instead of backtracking. Every package in the metapackage's
# dependency closure therefore has to be named with its version.
ARG TENSORRT_VERSION=10.16.1.11-1+cuda13.2
RUN apt-get update && \
    { apt-get remove -y 'libnvinfer.*' 'libnvonnxparsers.*' 'python3-libnvinfer.*' \
    tensorrt tensorrt-dev tensorrt-libs || true; } && \
    apt-get install -y --no-install-recommends --allow-downgrades \
    tensorrt=${TENSORRT_VERSION} \
    libnvinfer10=${TENSORRT_VERSION} \
    libnvinfer-plugin10=${TENSORRT_VERSION} \
    libnvinfer-vc-plugin10=${TENSORRT_VERSION} \
    libnvinfer-lean10=${TENSORRT_VERSION} \
    libnvinfer-dispatch10=${TENSORRT_VERSION} \
    libnvonnxparsers10=${TENSORRT_VERSION} \
    libnvinfer-bin=${TENSORRT_VERSION} \
    libnvinfer-dev=${TENSORRT_VERSION} \
    libnvinfer-plugin-dev=${TENSORRT_VERSION} \
    libnvinfer-vc-plugin-dev=${TENSORRT_VERSION} \
    libnvinfer-lean-dev=${TENSORRT_VERSION} \
    libnvinfer-dispatch-dev=${TENSORRT_VERSION} \
    libnvonnxparsers-dev=${TENSORRT_VERSION} \
    libnvinfer-headers-dev=${TENSORRT_VERSION} \
    libnvinfer-headers-plugin-dev=${TENSORRT_VERSION} \
    libnvinfer-headers-python-plugin-dev=${TENSORRT_VERSION} \
    libnvinfer-safe-headers-dev=${TENSORRT_VERSION} \
    python3-libnvinfer=${TENSORRT_VERSION} \
    python3-libnvinfer-dev=${TENSORRT_VERSION} \
    python3-libnvinfer-lean=${TENSORRT_VERSION} \
    python3-libnvinfer-dispatch=${TENSORRT_VERSION} \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

# Keep TensorRT libs on the default loader path for Python / ONNX Runtime.
ENV LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH}
RUN echo "export LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:\$LD_LIBRARY_PATH" >> ~/.bashrc

# JetPack 7.2 / Python 3.12 aarch64 wheel (see Ultralytics Jetson guide).
ARG ONNXRUNTIME_GPU_WHL=https://github.com/ultralytics/assets/releases/download/v0.0.0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl
# get_available_providers() only lists the EPs compiled into the wheel, so the ldd check
# is what actually catches a TensorRT runtime that the EP cannot link against.
RUN pip install --no-cache-dir "${ONNXRUNTIME_GPU_WHL}" onnx && \
    TRT_EP="$(python3 -c 'import os, onnxruntime; print(os.path.dirname(onnxruntime.__file__))')/capi/libonnxruntime_providers_tensorrt.so" && \
    if ldd "${TRT_EP}" | grep "not found"; then echo "TensorRT EP has unresolved libraries"; exit 1; fi && \
    python3 -c "import onnxruntime as ort; ps = ort.get_available_providers(); print('onnxruntime', ort.__version__, ps); assert 'TensorrtExecutionProvider' in ps"

###### MoGe monocular depth (optional --depth_source moge in node.py)
RUN pip install --no-cache-dir huggingface_hub \
    "git+https://github.com/EasternJournalist/utils3d.git@3fab839f0be9931dac7c8488eb0e1600c236e183"

###### Ultralytics detectors (YOLOE / SAM3)
# Blank pass so the pip installs and checkpoint downloads that ultralytics performs on
# first use happen here instead of at node startup. Needs network access (`--network host`).
# SAM3 weights are gated on Hugging Face: that part only warns and is done at runtime.
COPY initialize_detectors.py /initialize_detectors.py
RUN python3 /initialize_detectors.py

# Minimal ROS2 Jazzy image for DDS/topic connectivity testing on the Jetson AGX Thor
# (JetPack 7.2 GA / L4T 39.2.0). No CUDA, no FoundationPose dependencies: the point is to
# check whether this machine can see and receive the robot's topics before committing to
# the long build in docker_jetson/.
#
# Enough to run `ros2 topic list/echo/hz` and `dummy_node_sub.py` against the robot.
FROM ubuntu:24.04

ENV TZ=US/Pacific
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ARG DEBIAN_FRONTEND=noninteractive

# ROS2 requires a UTF-8 locale.
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    ca-certificates \
    git \
    vim \
    tmux \
 && locale-gen en_US en_US.UTF-8 \
 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

###### Network debugging tools (the usual suspects when DDS discovery fails)
RUN apt-get install -y \
    iproute2 \
    iputils-ping \
    net-tools \
    tcpdump \
    iperf3

###### Install ROS2 Jazzy (ros-base only: no rviz2, no gazebo, no desktop-full)
ENV ROS_DISTRO=jazzy
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# message_filters is what dummy_node_sub.py uses for the sync mode; demo-nodes give a
# talker/listener pair to check interop independently of the camera stream.
# rmw_cyclonedds_cpp is requested in the same transaction as ros-base so that it, rather
# than Fast DDS, satisfies the rmw_implementation dependency.
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-ros-base \
    ros-${ROS_DISTRO}-message-filters \
    ros-${ROS_DISTRO}-topic-tools \
    ros-${ROS_DISTRO}-demo-nodes-cpp \
    ros-${ROS_DISTRO}-demo-nodes-py \
 && rm -rf /var/lib/apt/lists/*

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc
RUN echo "export ROS_DOMAIN_ID=2" >> ~/.bashrc

# Setup shell
ENV SHELL=/bin/bash
RUN ln -sf /bin/bash /bin/sh
